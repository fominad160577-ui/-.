<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title>Задание | РСХБ</title>
    <!-- Подключаем стили -->
    <style>
      :root {
        --primary-dark: #1e7f35;
        --primary-light: #aec90b;
        --accent: #ffcb00;
        --text-dark: #2c3e50;
        --text-light: #ffffff;
        --bg-light: #f4f7f6;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        scroll-behavior: smooth;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
        color: var(--text-dark);
        background-color: var(--bg-light);
      }

      /* Боковая панель навигации */
      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 80px;
        height: 100vh;
        background-color: var(--primary-dark);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 20px;
        z-index: 1000;
      }

      .sidebar a {
        text-decoration: none;
        color: var(--text-light);
        margin-bottom: 110px;
        font-size: 12px;
        font-weight: bold;
        text-align: center;
        transition: transform 0.3s;
      }

      .sidebar a:hover {
        transform: scale(1.1);
      }

      .sidebar .dot {
        width: 10px;
        height: 10px;
        background-color: var(--primary-light);
        border-radius: 50%;
        display: block;
        margin: 0 auto 5px;
        opacity: 0.5;
      }

      .sidebar a.active .dot {
        opacity: 1;
      }

      /* Основной контент */
      .content {
        margin-left: 80px;
        padding: 40px 60px;
      }

      .section {
        min-height: 100vh;
        padding: 60px 0;
        border-bottom: 1px solid #e0e0e0;
      }

      .section h1 {
        color: var(--primary-dark);
        font-size: 2.5rem;
        margin-bottom: 20px;
        border-left: 6px solid var(--primary-light);
        padding-left: 15px;
      }

      .section h2 {
        color: var(--accent);
        font-size: 1.8rem;
        margin-bottom: 30px;
      }

      .card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        margin-bottom: 30px;
        height: 600px;
      }

/* Стиль для карточек кейсов */
#section4 .card {
    height: 300px;
}

#section4 ol li {
    /* Для лучшей читаемости в списке */
    padding-left: 18px;
    font-size: 1rem;
    line-height: 1.7;
}

      .card h3 {
        color: var(--primary-dark);
        margin-bottom: 15px;
      }

      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .tag {
        background-color: var(--primary-light);
        color: var(--text-dark);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
      }

      .timeline {
        position: relative;
        padding-left: 40px;
      }

      .timeline::before {
        content: "";
        position: absolute;
        left: 5px;
        top: 0;
        bottom: 0;
        width: 6px;
        background-color: var(--primary-dark);
      }

      .timeline-item {
        position: relative;
        margin-bottom: 100px;
        padding-left: 50px;
      }

      .timeline-item::before {
        content: "";
        position: absolute;
        left: -50px;
        top: 5px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background-color: var(--primary-light);
        border: 3px solid white;
      }

      .btn {
        display: inline-block;
        background-color: var(--primary-dark);
        color: white;
        padding: 12px 25px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        transition: background 0.3s;
      }

      .btn:hover {
        background-color: var(--accent);
        color: var(--text-dark);
      }

      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
      }

.card img {
    max-height: 80%; /* Картинка не будет больше самой карточки */
    display: block;
    margin: 0 auto;
}

      @media (max-width: 900px) {
        .content {
          margin-left: 0;
          padding: 20px;
        }

        .sidebar {
          display: none;
        }

        .grid-2 {
          grid-template-columns: 1fr;
        }
      }

      /* Стиль для карточек */
.grid-3 .card.modal-trigger {
    cursor: pointer;
    height: 300px;
    display: flex;
    align-items: center;
    color: var(--primary-dark);
    text-align: center;
}

/* Стиль для модального окна */
.modal {
    display: none;
    position: fixed;
    z-index: 1001;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.4);
    justify-content: center;
    align-items: center;
}

.modal-content {
    padding: 20px;
    border-radius: 10px;
    max-width: 600px;
    text-align: center;
    background-color: #fff;
}

.close-btn {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
}

.close-btn:hover,
.close-btn:focus {
    color: black;
    text-decoration: none;
    cursor: pointer;
}
/* Стиль для блоков-решений */
.solution-block {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    border-radius: 20px;
    background-color: #fff;
    box-shadow: inset 0 -3px 0 var(--color);
}
/* SVG-кружочки */
.solution-block::before {
    content: '';
    width: 30px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: var(--color);
}

/* Эффект переворота */
.flip-container {
    perspective: 1000px;
}

/* Одна карточка занимает ВСЮ ВЫСОТУ секции */
.flip-card {
    height: calc(100vh - 620px); /* Высота экрана минус отступы и заголовок */
    transform-style: preserve-3d;
    transition: all .6s ease-in-out;
    cursor: pointer;
}

.flip-card:hover,
.flip-card:focus-within { /* Для клавиатуры */
    transform: rotateY(180deg);
}

.front, 
.back {
    background-color: #fff;
    padding: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    backface-visibility: hidden;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    text-align: center;
    font-size: 1rem;
    line-height: 1.4;
}

/* Передняя сторона теперь содержит два месяца */
.front span {
    display: block;
    color: #888;
    margin-top: 1em;
}

.back {
    transform: rotateY(180deg); /* Изначально повернута к нам спиной */
    color: var(--text-dark);
    padding-top: 15px;
}

/* Адаптивность: на мобильных одна колонка */
@media (max-width: 900px) {
    .grid-2 {
        grid-template-columns: 1fr !important;
        gap: 30px; /* Расстояние между карточками на мобилках */
    }
}
    </style>
  </head>

  <body>
    <!-- Боковое меню -->
    <div class="sidebar" id="sidebar">
      <a href="#section1" class="active"><span class="dot"></span>Миссия</a>
      <a href="#section2"><span class="dot"></span>Сложности</a>
      <a href="#section3"><span class="dot"></span>Обучение</a>
      <a href="#section4"><span class="dot"></span>Кейсы</a>
      <a href="#section5"><span class="dot"></span>Продукт</a>
      <a href="#section6"><span class="dot"></span>План 2027</a>
      <a href="#section7"><span class="dot"></span>Заключение</a>
    </div>

    <!-- Контент сайта -->
    <div class="content">
      <!-- Секция 1: Миссия -->
<section id="section1" class="section">
    <h1>Цель/миссия наставника</h1>
    <!-- Увеличенный текст -->
    <p style="font-size: 1.5rem; line-height: 1.8; margin-bottom: 60px;"><b>Моя цель</b>: помочь человеку быстрее пройти путь, который он и сам способен пройти, — но с меньшим количеством ошибок, тупиков и потерь.<br><strong>Три главных качества наставника:</strong></p>
    
    <!-- Три карточки качеств -->
    <div class="grid-3">
        <div class="card">
            <img src="img/эмпатия.png" alt="эмпатия и терпение">
            <h3>Эмпатия и терпение</h3>
            <p>Умение слушать, слышать и поддерживать.</p>
        </div>
        
        <div class="card">
            <img src="img/профессионализм.jpg" alt="системность мышления">
            <h3>Профессионализм</h3>
            <p>Способность передать свои знания и опыт.</p>
        </div>
        
        <div class="card">
            <img src="img/честность.jpg" alt="умение задавать вопросы">
            <h3>Честность</h3>
            <p>Умение прямо, но уважительно сказать о недостатках и пробелах в знаниях.</p>
        </div>
    </div>
</section>

     <!-- Секция 2: Сложности -->
<section id="section2" class="section">
    <h1>Сложности работы наставника</h1>
    
    <!-- Увеличенный текст -->
    <p style="font-size: 1.5rem; line-height: 1.8;"><b>Основные сложности:</b></p>

    <!-- Карточки со сложностями -->
    <div class="grid-3">
        <!-- Эмоциональное выгорание -->
        <div class="card modal-trigger" data-modal-id="modal-burnout">
            <span class="icon">🔎</span><strong>Эмоциональное выгорание от постоянного «подавления» чужого стресса.</strong>
        </div>
        
        <!-- Разрыв теории и практики -->
        <div class="card modal-trigger" data-modal-id="modal-gap">
            <span class="icon">🔎</span><strong>Разница между теорией и реальностью (сложные клиенты).</strong>
        </div>
        
        <!-- Синдром самозванца -->
        <div class="card modal-trigger" data-modal-id="modal-impostor">
            <span class="icon">🔎</span><strong>Ответственность без контроля (результат работы зависит не только от тебя).</strong>
        </div>
    </div>

    <!-- Блок с решениями: иконки + текст --> 
    <div style="margin-top: 60px; font-size: 1.3rem; line-height: 1.7;"><strong>Как я планирую справляться:</strong><br> 
      <!-- Иконки с текстовыми блоками --> 
      <div class="solution-block" style="--color:#1e7f35;"> Профилактика</div>: афобазол (30мг один раз в день).<br><br>
      <div class="solution-block" style="--color:#aec90b;"> Реальность</div>: завранее предупредить о возможных вариантах развития событий. По возможности, пройти этот этап вместе.<br><br>
      <div class="solution-block" style="--color:#ffcb00;"> Мотивация</div>: предоставление честной обратной связи с фокусом на зонах роста.
    </div>

    <!-- Модальные окна -->
    <div class="modal" id="modal-burnout">
        <span class="close-btn">&times;</span>
        <h2>Эмоциональное выгорание</h2>
        <img src="img/выгорание.jpg" alt="Эмоциональное выгорание">
        <p>Это состояние усталости и истощения, которое возникает из-за постоянной эмоциональной нагрузки. Важно регулярно отдыхать и проводить супервизии.</p>
    </div>

    <div class="modal" id="modal-gap">
        <span class="close-btn">&times;</span>
        <h2>Разрыв теории и реальности</h2>
        <img src="img/реальность.jpg" alt="Теория vs практика">
        <p>Новичку сложно применять сухие инструкции в реальных ситуациях. Решение — обучение на практике и разбор кейсов.</p>
    </div>

    <div class="modal" id="modal-impostor">
        <span class="close-btn">&times;</span>
        <h2>Синдром самозванца</h2>
        <img src="img/помощь.jpg" alt="Синдром самозванца">
        <p>Ощущение, что ты недостаточно хорош(а), хотя объективно делаешь всё правильно. Помогают поддержка коллег и признание своих достижений.</p>
    </div>

</section>

      <!-- Секция 3: Обучение -->
      <section id="section3" class="section">
        <h1>Базовое обучение (8 дней)</h1>
        <p style="font-size: 1.5rem; line-height: 1.8;"><strong>Самое важное в первую неделю обучения:</strong> снять страх перед гарнитурой и CRM. Новичок должен понять, что система его не «съест», а клиент на том конце — такой же человек.</p>
        <div class="timeline">
          <div class="timeline-item">
            День 1–2: Онбординг. Техника безопасности, культура компании, этика общения.
          </div>
          <div class="timeline-item">
            День 3–4: Слепая печать и горячие клавиши CRM. Прослушивание эталонных звонков. Изучение продукта «изнутри».
          </div>
          <div class="timeline-item">
            День 5: Первые прослушивания живых звонков (LIVE). Наставник на второй линии.
          </div>
          <div class="timeline-item">
            День 6: Отработка возражений на тренажёре.
          </div>
          <div class="timeline-item">
            День 7: Самостоятельный приём простых обращений (статус заявки, адрес офиса).
          </div>
          <div class="timeline-item">
            День 8: Промежуточная аттестация и ретроспектива недели.
          </div>
        </div>
      </section>

      <!-- Секция 4: Кейсы -->
      <section id="section4" class="section">
    <h1>Кейсы</h1>

    <!-- Карточки -->
    <div style="margin-top: 30px;"> 
      <!-- Отступ от заголовка -->
        <div class="card modal-trigger" data-modal-id="modal-case-1">
            <h3>Кейс № 1: увольнение новичка</h3>
            <p><strong>Пример решения:</strong> «Право на передумку» — предложить отпуск на 3 дня или перевод в другую группу.</p>
        </div>

        <div class="card modal-trigger" data-modal-id="modal-case-2">
            <h3>Кейс № 2: мини-обучение по продукту</h3>
            <ol style="padding-left: 18px; font-size: 1rem; line-height: 1.7; margin-bottom: 50px;">
                <li>Мифы клиентов о кредите (15 мин). Что люди боятся больше всего (скрытые комиссии, страховка).</li>
                <li>Фишки нашего продукта (20 мин). Досрочное погашение без визитов, перенос даты платежа.</li>
                <li>Ролевые игры (25 мин). Продажа кредита клиенту, который пришёл только узнать баланс.</li>
            </ol>
        </div>
    </div>

    <!-- Модальные окна для видео -->
    <div class="modal video-modal" id="modal-case-1">
        <span class="close-btn">&times;</span>
        <video controls autoplay muted playsinline poster="img/preview_1.jpg">
            <source src="video/пашка.mp4" type="video/mp4">
            Ваш браузер не поддерживает тег video.
        </video>
    </div>

    <div class="modal video-modal" id="modal-case-2">
        <span class="close-btn">&times;</span>
        <video controls autoplay muted playsinline poster="img/preview_2.jpg">
            <source src="video/Ю.mp4" type="video/mp4">
            Ваш браузер не поддерживает тег video.
        </video>
    </div>
</section>
      <!-- Секция 5: Задача обучения -->
      <section id="section5" class="section">
        <h1>Задача обучения операторов</h1>
        <p>Познакомить сотрудников с продуктом так, чтобы они поняли характеристики, преимущества, научились рассказывать о нём клиентам, отвечать на их вопросы и знали, где оформить продукт.</p>
        <p>Для этого предлагаю модульную систему:</p>
        <div class="grid-2">
          <div>
            <h3>Модуль 1: Характеристики</h3>
            <p>Сухие факты: сроки, ставки, лимиты, требования к заемщику. Закрепляется тестом на знание цифр.</p>
          </div>
          <div>
            <h3>Модуль 2: Преимущества</h3>
            <p>Перевод характеристик на язык выгоды клиента. Не «ставка от 15%», а «фиксированный платеж, который не вырастет, даже если ЦБ поднимет ключевую ставку».</p>
          </div>
          <div>
            <h3>Модуль 3: Отработка</h3>
            <p>Сценарные диалоги. Как ответить на возражения: «А почему у соседа дешевле?» или «Мне не нужна страховка».</p>
          </div>
          <div>
            <h3>Модуль 4: Оформление</h3>
            <p>Велком-тренинг в CRM. Где нажать кнопку «Оформить», чтобы она сработала с первого раза.</p>
          </div>
        </div>
      </section>

      <!-- Секция 6: План мероприятий -->
      <section id="section6" class="section">
    <h1>План мероприятий КЦ на 2027 год</h1>
    
    <!-- Горизонтальная линия -->
    <hr style="border-color:#aec90b; margin-bottom:45px;" />

    <!-- Контейнер с флип-карточками -->
    <div class="grid-2 flip-container">
        <!-- ФЕВРАЛЬ -->
        <div class="flip-card">
            <div class="front">
              <span style="color:#ffcb00;">➤ ФЕВРАЛЬ:</span><br>
                <span style="color:#888;">Конкурс 🔎«Голос РСХБ»...</span>
            </div>
            <div class="back">
                Конкурс 🔎«Голос РСХБ» на лучшее качество речи и интонирование.<br>
                *Цель:* Повышение культуры общения и эмоциональной вовлечённости операторов.
                *Формат:* Запись коротких диалогов с клиентами. Оцениваются не только профессиональные навыки, но и эмпатия.
            </div>
        </div>
        
        <!-- МАЙ -->
        <div class="flip-card">
            <div class="front">
                <span style="color:#ffcb00;">➤ МАЙ:</span><br>
                <span style="color:#888;">Хакатон по оптимизации скриптов...</span>
            </div>
            <div class="back">
                Хакатон по оптимизации скриптов.<br>
                Операторы сами предлагают идеи, как сократить время обработки звонка.<br>
                *Цель:* Сокращение времени ожидания клиента и повышение конверсии.
                *Результат:* Лучшие решения внедряются сразу после завершения хакатона.
            </div>
        </div>

        <!-- АВГУСТ -->
        <div class="flip-card">
            <div class="front">
                <span style="color:#ffcb00;">➤ АВГУСТ:</span><br>
                <span style="color:#888;">Семейный день...</span>
            </div>
            <div class="back">
                Семейный день 🔎 Экскурсия в офис для детей сотрудников.<br>
                *Цель:* Укрепление командного духа через вовлечение семей.
                *Программа:* Экскурсия в новый офис, мастер-классы для детей и обед в корпоративной столовой.
            </div>
        </div>

        <!-- НОЯБРЬ -->
        <div class="flip-card">
            <div class="front">
                <span style="color:#ffcb00;">➤ АВГУСТ:</span><br>
                <span style="color:#888;">Финал года «Золотой колос...»</span>
            </div>
            <div class="back">
                Финал года 🔎 «Золотой колос РСХБ». Награждение лучших наставников и операторов.<br>
                *Номинации:* За KPI, за лучший выход из конфликта, самый быстрый рост.
                *Трансляция:* Мероприятие транслируется во все филиалы банка.
            </div>
        </div>
    </div>

    <!-- Секция 7: Прощание --> 
    <section id="section7" class="section"> 
      <div class="card" style="text-align:center;"> 
        <h1>Спасибо за внимание!</h1> 
        <p>Готова обсудить детали моего видения на собеседовании.</p> 
        <p><strong>Задание завершено.</strong></p> 
        <a href="#section1" class="btn">Вернуться в начало</a> 
      </div> 
    </section>

    <!-- Горизонтальная линия снизу -->
    <hr style="margin-top:45px; border-color:#aec90b;" />
</section>

      <!-- Навигация по сайту при скролле -->
      <script>
        const sections = document.querySelectorAll("section");
        const sidebarLinks = document.querySelectorAll(".sidebar a");

        function activateMenu() {
          let scrollY = window.scrollY;
          sections.forEach((sec) => {
            const sectionHeight = sec.offsetHeight;
            const sectionTop = sec.offsetTop - 100;
            const sectionId = sec.getAttribute("id");
            if (
              scrollY > sectionTop &&
              scrollY <= sectionTop + sectionHeight
            ) {
              sidebarLinks.forEach((a) => {
                a.classList.remove("active");
                if (a.getAttribute("href") === `#${sectionId}`) {
                  a.classList.add("active");
                }
              });
            }
          });
        }

        window.addEventListener("scroll", activateMenu);
      </script>
    </div>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll('.modal-trigger');
    const modals = document.querySelectorAll('.modal');

    // Показываем модальное окно
    triggers.forEach(trigger => trigger.addEventListener('click', e => {
        const modalId = trigger.getAttribute('data-modal-id');
        const modal = document.getElementById(modalId);
        if (!modal) return;
        modal.style.display = 'flex';
    }));

    // Закрываем модальное окно
    modals.forEach(modal => {
        const closeBtn = modal.querySelector('.close-btn');
        closeBtn.addEventListener('click', () => { modal.style.display = 'none'; });

        // Или по клику вне содержимого
        window.addEventListener('click', event => {
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        });
    });
});
</script>
  </body>
</html>